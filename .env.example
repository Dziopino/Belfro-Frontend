# Wzór nazw zmiennych frontendu. Skopiuj do `frontend/.env` i uzupełnij.
# Wszystko, co tu wpiszesz, trafia do pakietu przeglądarki — nie umieszczaj tu żadnych sekretów.

# Pełny adres API razem z przedrostkiem /api. Bez tego src/services/apiService.ts:39
# wraca do http://localhost:3000/api, czyli działa tylko przy lokalnym backendzie.
VITE_API_URL=http://localhost:3000/api

# Domena publiczna serwisu, potrzebna wyłącznie do sitemap.xml (scripts/gen-sitemap.mjs).
# Nieustawiona = build pomija sitemap i drukuje powód.
VITE_SITE_URL=
